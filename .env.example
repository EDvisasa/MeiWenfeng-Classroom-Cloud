# ==========================================
# 媚吻锋随身课堂 - 环境变量配置模板
# ==========================================

# 1. 后端与服务端口配置
PORT=8000
FRONTEND_PORT=5173

# 2. DeepSeek API 配置 (第一阶段 MVP 必需)
# 填写您的 DeepSeek API Key 才能进行对话
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 3. 本地 RAGFlow 知识库配置 (第二阶段使用)
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_BASE_URL=http://localhost/api/v1

# 4. 本地模型配置 (供第四阶段多模型切换备用)
QWEN_LOCAL_URL=http://localhost:8080/v1
GEMMA_LOCAL_URL=http://localhost:11434/v1
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
